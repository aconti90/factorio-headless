# Copy to .env next to your compose file and fill in.
#   cp .env.example .env

# Required: RCON is an admin console, so the image refuses to run it unprotected.
RCON_PASSWORD=change-me

# Optional: only needed to make the server publicly listed in the in-game browser.
# Get the token from https://factorio.com/profile
# FACTORIO_USERNAME=
# FACTORIO_TOKEN=
