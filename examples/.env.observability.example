# Copy to .env next to docker-compose.observability.yml and fill in.
#   cp .env.observability.example .env

# Required: shared between the factorio and exporter services.
RCON_PASSWORD=change-me

# Required: Grafana admin login. Change this from the default.
GRAFANA_ADMIN_PASSWORD=change-me

# Optional: only needed if `docker compose up` fails with "no matching
# manifest for linux/arm64/v8" (observed on some Docker versions on
# Raspberry Pi). Uncomment if you hit that.
# DOCKER_PLATFORM=linux/arm64

# Optional: on arm64 (e.g. Raspberry Pi), stable has no arm64 build yet —
# uncomment this or the factorio service will fail to pull.
# FACTORIO_TAG=experimental

# Optional: only needed if you already have something on port 3000.
# GRAFANA_PORT=3001
